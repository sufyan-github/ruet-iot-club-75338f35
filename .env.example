# Frontend configuration. The production API is same-origin by default.
VITE_API_BASE_URL=/api/v1
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Worker-only email routing variables are configured as Wrangler vars, never exposed to Vite.
CONTACT_AUTHORITY_EMAIL=
SUPER_ADMIN_EMAIL=
MEMBERSHIP_EMAIL=
RESEARCH_EMAIL=
PROJECT_EMAIL=
COLLABORATION_EMAIL=
