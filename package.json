{
  "name": "ruet-iot-club-platform",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.16.0 <25",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "vite",
    "dev:web": "vite",
    "dev:worker": "wrangler dev",
    "build": "vite build",
    "build:worker": "wrangler deploy --dry-run --env= --outdir .wrangler-dist",
    "build:dev": "vite build --mode development",
    "lint": "eslint .",
    "lint:worker": "eslint worker --max-warnings 0",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:worker": "vitest run --config vitest.worker.config.ts",
    "test:all": "npm run test && npm run test:worker",
    "typecheck": "tsc -b --pretty false && npm run typecheck:worker",
    "typecheck:worker": "tsc -p worker/tsconfig.json --noEmit && tsc -p worker/test/tsconfig.json --noEmit",
    "cf:types": "wrangler types",
    "cf:types:check": "wrangler types --check",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "check:phase1": "npm run cf:types:check && npm run typecheck && npm run lint:worker && npm run test:all && npm run db:migrate:local && npm run build && npm run build:worker",
    "check:phase2": "npm run cf:types:check && npm run typecheck && npm run lint:worker && npm run test:all && npm run db:migrate:local && npm run build && npm run build:worker && npm audit --audit-level=high",
    "check:phase3": "npm run cf:types:check && npm run typecheck && npm run lint:worker && npm run test:all && npm run db:migrate:local && npm run build && npm run build:worker && npm audit --audit-level=high",
    "check:phase4": "npm run cf:types:check && npm run typecheck && npm run lint:worker && npm run test:all && npm run db:migrate:local && npm run build && npm run build:worker && npm audit --audit-level=high",
    "check:phase5": "npm run cf:types:check && npm run typecheck && npm run lint:worker && npm run test:all && npm run db:migrate:local && npm run build && npm run build:worker && npm audit --audit-level=high"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@hookform/resolvers": "^3.10.0",
    "@radix-ui/react-accordion": "^1.2.11",
    "@radix-ui/react-alert-dialog": "^1.1.14",
    "@radix-ui/react-aspect-ratio": "^1.1.7",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-collapsible": "^1.1.11",
    "@radix-ui/react-context-menu": "^2.2.15",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-hover-card": "^1.1.14",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-menubar": "^1.1.15",
    "@radix-ui/react-navigation-menu": "^1.2.13",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-radio-group": "^1.3.7",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slider": "^1.3.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-toast": "^1.2.14",
    "@radix-ui/react-toggle": "^1.1.9",
    "@radix-ui/react-toggle-group": "^1.1.10",
    "@radix-ui/react-tooltip": "^1.2.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^3.6.0",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^12.35.1",
    "hono": "^4.13.3",
    "htmlparser2": "^12.0.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.462.0",
    "next-themes": "^0.3.0",
    "react": "^18.3.1",
    "react-day-picker": "^8.10.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^3.0.0",
    "react-hook-form": "^7.61.1",
    "react-resizable-panels": "^2.1.9",
    "react-router-dom": "^7.18.2",
    "recharts": "^2.15.4",
    "sonner": "^1.7.4",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "vaul": "^0.9.9",
