{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ruet-iot-club-platform",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "upload_source_maps": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "vars": {
    "ENVIRONMENT": "development",
    "SITE_URL": "http://127.0.0.1:8787",
    "FRONTEND_ORIGIN": "http://127.0.0.1:8080",
    "TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
    "EMAIL_FROM": "no-reply@example.invalid",
    "CONTACT_AUTHORITY_EMAIL": "ruetiotclub@gmail.com",
    "SUPER_ADMIN_EMAIL": "abusufyan.cse20@gmail.com",
    "MEMBERSHIP_EMAIL": "ruetiotclub@gmail.com",
    "RESEARCH_EMAIL": "ruetiotclub@gmail.com",
    "PROJECT_EMAIL": "ruetiotclub@gmail.com",
    "COLLABORATION_EMAIL": "ruetiotclub@gmail.com"
  },
  "secrets": {
    "required": ["SESSION_SECRET", "TURNSTILE_SECRET", "BOOTSTRAP_ADMIN_SECRET"]
  },
  "send_email": [{ "name": "EMAIL" }],
  "triggers": { "crons": ["*/5 * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ruet-iot-club-development",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "STORAGE",
      "bucket_name": "ruet-iot-club-development"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1
    }
  },
  "env": {
    "staging": {
      "name": "ruet-iot-club-platform-staging",
      "vars": {
        "ENVIRONMENT": "staging",
        "SITE_URL": "https://ruet-iot-club-platform-staging.ruet-iot-club-platform.workers.dev",
        "FRONTEND_ORIGIN": "https://ruet-iot-club-platform-staging.ruet-iot-club-platform.workers.dev",
        "TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
        "EMAIL_FROM": "no-reply@staging.example.invalid",
        "CONTACT_AUTHORITY_EMAIL": "ruetiotclub@gmail.com",
        "SUPER_ADMIN_EMAIL": "abusufyan.cse20@gmail.com",
        "MEMBERSHIP_EMAIL": "ruetiotclub@gmail.com",
        "RESEARCH_EMAIL": "ruetiotclub@gmail.com",
        "PROJECT_EMAIL": "ruetiotclub@gmail.com",
        "COLLABORATION_EMAIL": "ruetiotclub@gmail.com"
      },
      "secrets": {
        "required": ["SESSION_SECRET", "TURNSTILE_SECRET", "BOOTSTRAP_ADMIN_SECRET"]
      },
      "send_email": [{ "name": "EMAIL" }],
      "triggers": { "crons": ["*/5 * * * *"] },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "ruet-iot-club-staging",
          "database_id": "9ade4800-ee25-4ccd-a6a9-889ea1687f4a",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "STORAGE",
          "bucket_name": "ruet-iot-club-staging"
        }
      ]
    },
    "production": {
      "name": "ruet-iot-club-platform-production",
      "routes": [
        {
          "pattern": "ruetiotclub.org",
          "custom_domain": true
        },
        {
          "pattern": "www.ruetiotclub.org",
          "custom_domain": true
        }
      ],
      "vars": {
        "ENVIRONMENT": "production",
        "SITE_URL": "https://ruetiotclub.org",
        "FRONTEND_ORIGIN": "https://ruetiotclub.org",
        "TURNSTILE_SITE_KEY": "0x4AAAAAAEXg7pRaP0uW2NHA",
        "EMAIL_FROM": "no-reply@ruetiotclub.org",
        "CONTACT_AUTHORITY_EMAIL": "ruetiotclub@gmail.com",
        "SUPER_ADMIN_EMAIL": "abusufyan.cse20@gmail.com",
        "MEMBERSHIP_EMAIL": "ruetiotclub@gmail.com",
        "RESEARCH_EMAIL": "ruetiotclub@gmail.com",
        "PROJECT_EMAIL": "ruetiotclub@gmail.com",
        "COLLABORATION_EMAIL": "ruetiotclub@gmail.com"
      },
      "secrets": {
        "required": ["SESSION_SECRET", "TURNSTILE_SECRET", "BOOTSTRAP_ADMIN_SECRET"]
      },
      "send_email": [{ "name": "EMAIL" }],
      "triggers": { "crons": ["*/5 * * * *"] },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "ruet-iot-club-production",
          "database_id": "2a3a1234-60ba-4bed-974a-c2a0c08beb68",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "STORAGE",
          "bucket_name": "ruet-iot-club-production"
        }
      ]
    }
  }
}
